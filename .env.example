# ============================================================================
# STRETCH website — environment variables. EVERY variable is optional: with
# none set the site builds and runs (analytics no-op, leads are logged to the
# server console, /portal runs in demo mode, all anti-spam features are off).
# Copy to .env.local for local development; set production values in Vercel.
# ============================================================================

# --- Site ------------------------------------------------------------------
# Absolute production URL of the default (EN) domain — canonicals, sitemap,
# OG images, JSON-LD @id. Per-locale domains are configured in code
# (src/i18n/config.ts) and can be overridden with NEXT_PUBLIC_DOMAIN_<LOCALE>.
NEXT_PUBLIC_SITE_URL=https://stretch.mt

# --- Analytics (all consent-gated by the cookie banner) --------------------
# Google Analytics 4. The unsuffixed ID is the fallback for every locale;
# NEXT_PUBLIC_GA_ID_<LOCALE> (EN, UK, US, BE, NL, FR, PL, DE, CH, ES, PT, DA,
# SV, NO, IS) overrides per domain. Same pattern for Clarity.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
# Off by default per brief:
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_BING_UET_ID=

# --- Lead delivery (first configured method wins: Graph → webhook → SMTP) --
# Destination inbox for every form submission:
LEAD_DESTINATION=info@stretchplafonds.be
# From-address used by the transactional sender (datasheet emails etc.):
LEAD_FROM_EMAIL=
# Microsoft 365 (Graph, app-only Mail.Send) — setup notes in src/lib/msgraph-mail.ts:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_SENDER=
# Or POST each lead as JSON to a webhook:
LEAD_WEBHOOK_URL=
# Or plain SMTP (Nodemailer — optional dependency, loaded only when set):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=

# --- Switzerland (stretchdecken.ch, QuinLay AG) -----------------------------
# Every Swiss lead (submitted on the ch domain, or with a Swiss dealer/training
# source) is delivered TO this address with LEAD_DESTINATION in CC. Default:
# office@quinlay.ch (src/lib/site-config.ts swissPartner).
QUINLAY_LEAD_EMAIL=office@quinlay.ch

# --- Client portal (Supabase) ----------------------------------------------
# Without these /portal runs in demo mode (sample data + demo logins).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — admin API (pricelist sync, account management, signup profile
# creation). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to allow the built-in demo logins when Supabase is NOT configured.
NEXT_PUBLIC_PORTAL_DEMO=

# --- Portal on one host -----------------------------------------------------
# Canonical portal host (production: stretch.mt). When set, /portal on every
# other production domain 308-redirects there, /api/portal/* answers 404 on
# non-canonical production hosts, and portal links become absolute. localhost
# and *.vercel.app previews are never redirected. Unset = portal reachable on
# every domain, exactly as before.
NEXT_PUBLIC_PORTAL_HOST=

# --- Anti-spam (docs/ANTI-SPAM.md) ------------------------------------------
# Cloudflare Turnstile. Two widget groups because one widget allows at most
# 10 hostnames (14 domains + previews + localhost don't fit in one):
#   Group A: stretch.mt, stretch-ceilings.uk, stretchplafond.be,
#            stretchplafond.nl, stretchplafond.fr, stretch-sufit.pl,
#            stretchdecken.de, stretchtecho.es, stretch-website-seven.vercel.app,
#            localhost
#   Group B: stretchteto.pt, straekloft.dk, stretchceilings.se,
#            stretchtak.no, stretch.is
# Unset = no CAPTCHA anywhere (zero-config). Set BOTH the sitekey and secret
# of a group. Local E2E test keys: sitekey 1x00000000000000000000AA /
# secret 1x0000000000000000000000000000000AA (always passes).
NEXT_PUBLIC_TURNSTILE_SITEKEY_A=
TURNSTILE_SECRET_A=
NEXT_PUBLIC_TURNSTILE_SITEKEY_B=
TURNSTILE_SECRET_B=
# HMAC secret for the time-to-submit form tokens. Any long random string
# (openssl rand -hex 32). Falls back to DATASHEET_SIGNING_SECRET, then to an
# insecure dev default with a console warning.
FORM_SIGNING_SECRET=
# Recipient of the signup circuit-breaker alert (>30 portal signups/hour).
# Falls back to LEAD_DESTINATION.
PORTAL_ADMIN_EMAIL=

# --- Signed download links ---------------------------------------------------
# Signs the expiring 14-day datasheet download links (src/lib/datasheet-links.ts).
DATASHEET_SIGNING_SECRET=
