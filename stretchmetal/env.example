# ============================================================================
# StretchMetal — environment variables. EVERY variable is optional: with none
# set, the site builds and runs, analytics no-op and RFQ/contact submissions
# are logged to the server console instead of e-mailed.
# Copy to .env.local for local development; set on Vercel for production.
# ============================================================================

# --- Site ---------------------------------------------------------------------
# Absolute production origin (no trailing slash). Drives canonicals, hreflang,
# sitemap, OG URLs and JSON-LD @id. Falls back to https://stretchmetal.pl.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (all consent-gated by the cookie banner) -----------------------
# PostHog project API key + host. EU cloud default: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 measurement ID (G-XXXXXXX). Loads under Consent Mode v2.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID. Loads only after analytics consent.
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel ID. Loads only after marketing consent.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Mail (Microsoft Graph, client credentials) -------------------------------
# App registration with APPLICATION permission Mail.Send + admin consent.
# Full setup walkthrough: lib/email.ts header comment.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=

# Inbox that receives RFQ + contact submissions. Defaults to the public
# contact address (info@stretchmetal.pl) when unset.
RFQ_DESTINATION=
